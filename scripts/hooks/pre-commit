#!/usr/bin/env bash
# Blocks commits that break the package or leak private terms.
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -e
top="$(git rev-parse --show-toplevel)"
node "$top/scripts/validate.mjs"
node --test --test-reporter=dot "$top/scripts/validate.test.mjs" "$top/scripts/schema-validation.test.mjs" "$top/scripts/install.test.mjs"
