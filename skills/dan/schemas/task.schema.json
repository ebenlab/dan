{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ebenlab/dan/skills/dan/schemas/task.schema.json",
  "title": "Task",
  "description": "One unit of work. Workflow state and verification state are tracked separately.",
  "type": "object",
  "required": ["id", "workspace", "sources", "intended_outcome", "workflow_state", "verification_state", "permission", "last_verified_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Stable task ID." },
    "workspace": { "type": "string", "description": "Workspace adapter ID this task belongs to." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "source_id"],
        "additionalProperties": false,
        "properties": {
          "system": { "type": "string", "description": "e.g. github, linear, slack, email" },
          "source_id": { "type": "string", "description": "Exact identifier in that system (used for dedupe)." },
          "url": { "type": "string" },
          "revision": { "type": "string", "description": "Commit, version or edit timestamp seen." }
        }
      }
    },
    "requester": { "type": "string" },
    "owner": { "type": "string" },
    "assignment_evidence": { "type": "string", "description": "Why we believe this is ours. Assignment alone is not a permission." },
    "intended_outcome": { "type": "string" },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "priority_rationale": { "type": "string" },
    "due": {
      "type": "object",
      "required": ["at", "timezone"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "description": "IANA timezone, e.g. America/Toronto" }
      }
    },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "evidence_status": { "enum": ["verified", "supported_incomplete", "conflicted", "unknown"] },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "permission": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
        "grant_ref": { "type": "string", "description": "Reference into the runtime's permission registry. Absent means default A1 or lower." },
        "permitted_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_minutes": { "type": "number" },
        "max_cost_usd": { "type": "number" },
        "max_review_rounds": { "type": "integer" }
      }
    },
    "stop_conditions": { "type": "array", "items": { "type": "string" } },
    "workflow_state": {
      "enum": ["discovered", "triaged", "ready", "working", "blocked", "awaiting_approval", "handed_off", "completed", "superseded"]
    },
    "verification_state": {
      "enum": ["reported", "inspected", "reproduced", "validated"]
    },
    "lease": {
      "type": "object",
      "description": "One active worker per task/repo change.",
      "required": ["holder", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "holder": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["started_at", "result"],
        "properties": {
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "result": { "type": "string" },
          "checkpoint": { "type": "string" }
        }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" }, "description": "IDs of evidence records." },
    "action_proposals": { "type": "array", "items": { "type": "string" }, "description": "IDs of action proposals." }
  }
}
